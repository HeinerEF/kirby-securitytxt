      "homepage": "https://github.com/HeinerEF",
      "role":     "Developer"
    }
  ],
  "support": {
    "docs":   "https://github.com/HeinerEF/kirby-securitytxt/blob/main/README.md",
    "source": "https://github.com/HeinerEF/kirby-securitytxt/"
  },
  "require": {
    "getkirby/composer-installer": "^1.2"
